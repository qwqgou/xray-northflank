# ===========================================================================
#  xray-northflank :: public HTTP server block
#  Rendered by entrypoint.sh (envsubst) into /etc/nginx/conf.d/site.conf
#  Placeholders: ${LISTEN_PORT} ${XRAY_PORT} ${XHTTP_PORT} ${WS_PORT}
#                ${WS_PATH} ${XHTTP_PATH}
#  The *_PATH values already include their leading slash (entrypoint.sh
#  normalises them with norm_path), so never write "/${XHTTP_PATH}": that
#  produces a "//xhttp" location, which nginx rejects outright.
#
#  The two marker comments at the very end of this file delimit the optional
#  WebSocket vhost, which is deleted at startup when ENABLE_WS is not "true".
#  Both markers sit INSIDE the server braces, so deleting the range cannot
#  unbalance them; entrypoint.sh asserts the brace count afterwards.
# ===========================================================================
server {
    listen       ${LISTEN_PORT} default_server;
    listen       [::]:${LISTEN_PORT} default_server;
    server_name  _;

    charset utf-8;
    root  /usr/share/nginx/html;
    index index.html;

    # -------------------------------------------------------------------
    # Health probe (also what the Docker HEALTHCHECK hits)
    # -------------------------------------------------------------------
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    # ===================================================================
    # VLESS + XHTTP   (path: /${XHTTP_PATH})   <- the modern transport
    # XHTTP (formerly SplitHTTP) speaks ordinary HTTP/1.1 requests, so a
    # plain proxy location is enough.  It keeps working where WebSocket
    # upgrades are blocked or stripped by an intermediary.
    # ===================================================================
    location ^~ ${XHTTP_PATH} {
        proxy_pass http://127.0.0.1:${XHTTP_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_redirect off;

        # long-lived streaming downloads
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
        proxy_request_buffering off;
        chunked_transfer_encoding on;
        client_max_body_size 0;

        # Uncomment while debugging; XHTTP produces very chatty access logs.
        # access_log off;
    }

    # ===================================================================
    # Everything else -> normal-looking decoy site
    # ===================================================================
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }

# WG_WS_START
    # ===================================================================
    # VLESS + WebSocket   (path: ${WS_PATH})   [deprecated in Xray 26.x]
    # A genuine WebSocket handshake is proxied to Xray. Everything else on
    # this path is answered with the decoy site, so an active prober sees an
    # ordinary page instead of Xray's "400 Bad Request" fingerprint.
    #
    # The upgrade test is a `map` ($xnf_ws_upgrade, defined in nginx.conf).
    # ===================================================================
    location ^~ ${WS_PATH} {
        # A genuine handshake is proxied to Xray; anything else is answered
        # with the decoy page, so a prober sees what any other path returns.
        #
        # The shape below is the only one verified to work on nginx 1.22:
        #   * try_files in this location runs in the rewrite phase BEFORE the
        #     `if`, so it swallows real handshakes (hard 404 for clients);
        #   * `if`+proxy_pass cannot carry proxy_http_version / proxy_set_header
        #     (only proxy_pass, proxy_set_header, proxy_redirect and break are
        #     allowed inside `if`);
        #   * a variable `root` makes every element miss, and `error_page`
        #     INSIDE an `if` never resolves the named location (bare 404).
        if ($xnf_ws_upgrade != "1") { return 418; }
        error_page 418 = @xnf_decoy;
        proxy_pass http://127.0.0.1:${WS_PORT};
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       $host;
        proxy_set_header X-Real-IP  $remote_addr;
        proxy_redirect off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    # Decoy page for the WebSocket path (see above). Never reached directly.
    location @xnf_decoy {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html =404;
    }
# WG_WS_END
}
