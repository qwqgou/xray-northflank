# Shell scripts, nginx configs and the Dockerfile MUST stay LF in the repo:
# they are executed inside a Linux container, where CRLF breaks shebangs
# (e.g. "bash\r: No such file or directory") and nginx directives.
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.tmpl      text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.html      text eol=lf

# Binary assets are never touched.
*.png binary
*.jpg binary
*.ico binary
*.zip binary
*.gz  binary
